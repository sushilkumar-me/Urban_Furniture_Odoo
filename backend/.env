# ============================================================
# .env  — Environment Variables
#
# This file stores ALL configuration for the app.
# It is NEVER committed to git. Keep it secret.
#
# Why do we use .env instead of hardcoding values?
#   - Security: passwords stay out of your Python code
#   - Flexibility: change values without touching code
#   - Industry standard: every real project does this
# ============================================================

# Name shown at the top of the automatic API docs page
APP_NAME="Urban Furniture Accounting System"

# Version shown in the API docs
APP_VERSION="1.0.0"

# Debug mode:
#   True  = show detailed error messages (development)
#   False = hide error details (production)
DEBUG=True

# ---- DATABASE CONNECTION STRING ---------------------------
#
# Format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Breaking it down:
#   postgresql               → database type (we use PostgreSQL)
#   postgres                 → your PostgreSQL username
#   1234                     → your PostgreSQL password
#   localhost                → server address (our own machine)
#   5432                     → PostgreSQL default port
#   urban_furniture_accounting_db → the database name
#
# This is the ONLY place this value lives.
# database.py reads it from here via config.py.
# You never type this password anywhere else in the code.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/urban_furniture_accounting_db
