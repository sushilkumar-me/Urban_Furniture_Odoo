# ============================================================
# .env  — Environment Variables
#
# This file stores configuration values for the app.
# It is NEVER committed to git. Keep it secret.
#
# python-dotenv reads this file and makes these values
# available to our Python code via os.getenv() or
# our Settings class in config.py
# ============================================================

# The name shown in the API documentation page
APP_NAME="Urban Furniture Accounting System"

# Version of the API (shown in docs)
APP_VERSION="1.0.0"

# Debug mode:
#   True  = show detailed error messages (use during development)
#   False = hide error details (use in production / hackathon demo)
DEBUG=True

# ---- DATABASE (we will fill these in Phase 2) ----
# These are placeholders for now. Do NOT change them yet.
# We will set the real values when we connect PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/urban_furniture_db
